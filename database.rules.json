{
  "rules": {
    "printJobs": {
      ".indexOn": ["status", "createdAt"],
      ".read": "root.child('adminUsers').child(auth.uid).child('role').val() == 'admin'",
      "$jobId": {
        ".read": true,
        ".write": "!data.exists() || root.child('adminUsers').child(auth.uid).child('role').val() == 'admin'",
        ".validate": "newData.hasChildren(['jobId', 'fileName', 'storagePath', 'fileUrl', 'fileSize', 'copies', 'pageSelection', 'printMode', 'duplex', 'status', 'createdAt']) && newData.child('jobId').val() == $jobId && $jobId.length == 16 && $jobId.beginsWith('PR-')",
        "jobId": { ".validate": "newData.isString()" },
        "studentName": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
        "className": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "section": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
        "rollNumber": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "fileName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
        "storagePath": { ".validate": "newData.isString() && newData.val().beginsWith('printJobs/' + $jobId + '/original.') && newData.val().length <= 300" },
        "fileUrl": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "fileSize": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 52428800" },
        "copies": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
        "pageSelection": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
        "printMode": { ".validate": "newData.val() == 'BLACK_WHITE' || newData.val() == 'COLOUR'" },
        "duplex": { ".validate": "newData.val() == 'SINGLE' || newData.val() == 'DOUBLE'" },
        "orientation": { ".validate": "newData.val() == 'PORTRAIT' || newData.val() == 'LANDSCAPE'" },
        "status": {
          ".validate": "(newData.val() == 'WAITING_APPROVAL' || newData.val() == 'APPROVED' || newData.val() == 'REJECTED' || newData.val() == 'PRINTING' || newData.val() == 'SAVING' || newData.val() == 'PRINTED' || newData.val() == 'SAVED' || newData.val() == 'FAILED' || newData.val() == 'CANCELLED') && (data.exists() || newData.val() == 'WAITING_APPROVAL' || newData.val() == 'APPROVED')"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "approvedAt": { ".validate": "newData.isNumber()" },
        "printingAt": { ".validate": "newData.isNumber()" },
        "savingAt": { ".validate": "newData.isNumber()" },
        "printedAt": { ".validate": "newData.isNumber()" },
        "savedAt": { ".validate": "newData.isNumber()" },
        "failedAt": { ".validate": "newData.isNumber()" },
        "errorMessage": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "$other": { ".validate": false }
      }
    },
    "settings": {
      ".read": true,
      ".write": "root.child('adminUsers').child(auth.uid).child('role').val() == 'admin'",
      ".validate": "newData.hasChildren(['schoolName', 'maxFileSize', 'maxCopies', 'allowedFileTypes', 'printApprovalRequired', 'defaultPrintMode', 'defaultDuplex'])",
      "schoolName": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
      "maxFileSize": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
      "maxCopies": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
      "allowedFileTypes": { ".validate": "newData.hasChildren() && newData.hasChild('0')" },
      "printApprovalRequired": { ".validate": "newData.isBoolean()" },
      "defaultPrintMode": { ".validate": "newData.val() == 'BLACK_WHITE' || newData.val() == 'COLOUR'" },
      "defaultDuplex": { ".validate": "newData.val() == 'SINGLE' || newData.val() == 'DOUBLE'" },
      "$other": { ".validate": false }
    },
    "adminUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    }
  }
}
